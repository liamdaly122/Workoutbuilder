# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard). See SETUP.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run `npm run seed:supabase` once. Never put this in
# Vercel, never commit it, never prefix it with VITE_ (that would ship it to
# the browser). Keep it in .env.local only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
